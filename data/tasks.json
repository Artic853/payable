      "budget_paise": 700000,
      "expected_sku": "KB-MECH-87-BRN",
      "constraints": [
        {
          "field": "layout",
          "op": "eq",
          "value": "TKL-87"
        },
        {
          "field": "switch_type",
          "op": "eq",
          "value": "brown-tactile"
        },
        {
          "field": "connectivity",
          "op": "contains",
          "value": "bluetooth"
        }
      ]
    },
