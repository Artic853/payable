# Copy to .env and fill in what you have. Every one of these is optional --
# with none of them set, the whole system still runs end to end offline.

# --- Razorpay (test mode) ---------------------------------------------------
# With these set, orders and payment links are created for real against
# Razorpay test mode. Capture still needs the hosted checkout, so the capture
# leg is simulated and labelled "razorpay-api+simulated-capture".
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Audit log --------------------------------------------------------------
# Set to move the audit log from data/audit.jsonl to Redis Streams.
# REDIS_URL=redis://localhost:6379/0

# --- Buyer reasoning --------------------------------------------------------
# Set both to have the buyer turn briefs into constraints with an LLM instead
# of the deterministic extractor. The benchmark stays on the deterministic path
# unless you opt in, so its numbers do not move between runs.
# PAYABLE_USE_LLM=1
# ANTHROPIC_API_KEY=sk-ant-...
# PAYABLE_LLM_MODEL=claude-sonnet-5

# --- Mandate signing --------------------------------------------------------
# In production this is the principal's key, not the merchant's. Change it.
# PAYABLE_MANDATE_SECRET=change-me

# --- Benchmark knobs --------------------------------------------------------
# PAYABLE_SEED=1733
# PAYABLE_PAYMENT_FAILURE_RATE=0.12
# PAYABLE_BASE_URL=http://127.0.0.1:8000
